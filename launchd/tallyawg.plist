<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.github.blackkriger.tallyawg</string>
	<!-- Flags live here: add them after "serve", one <string> per word. -->
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/tallyawg</string>
		<string>serve</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/var/log/tallyawg.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/tallyawg.log</string>
</dict>
</plist>
