# Flags passed to `tallyawg serve` (word-split by systemd).
# Written to /etc/tallyawg/tallyawg.env on the first `tallyawg install`; yours is kept afterwards.
#
#   -i <iface>        interface(s) to account, comma-separated (default: every up wg/awg one)
#   -config <file>    server .conf(s) to read friendly "# name" peer comments from
#   -names <file>     optional "<pubkey-or-address> <name>" mapping
#   -wg <bin>         wg-tools binary (default: awg, then wg)
#   -data <file>      ledger file (default: /var/lib/tallyawg/ledger.json)
#   -tz <zone>        timezone for today/month: UTC, an offset like +3, or an IANA name
#   -listen <addr>    web page address (default: 127.0.0.1:8082)
#   -admin <addr>     tunnel address(es) allowed to add/remove peers (the loopback always is)
#   -interval <dur>   collection interval (default: 5m)
#
# Everything is auto-detected out of the box, so leave this empty unless you need to override
# something. Example:
#
#TALLYAWG_FLAGS=-i awg0 -config /etc/amnezia/amneziawg/awg0.conf -tz +3
TALLYAWG_FLAGS=
